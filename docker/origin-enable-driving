#!/usr/bin/env bash
# Let the autonomy stack drive the real Origin One:
#   1. switch the robot's cmd_vel_controller to USER control mode (30), so it executes
#      /robot/cmd_vel_user (Avular: software_development/ros2/ros2_interfaces/control_interface)
#   2. start the frontier explorer (explore mode); in navigate mode, send RViz goals.
# Keep a hand on the e-stop. Undo with origin-stop-driving.
source /opt/origin_ws/entrypoint_env.sh
# The Zenoh bridge is only discovered with network-wide discovery, and its service routes need
# CycloneDDS requests (Avular: RMW_IMPLEMENTATION=rmw_cyclonedds_cpp on the external computer).
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
ROBOT_RMW=rmw_cyclonedds_cpp
SRV=/robot/cmd_vel_controller/set_control_mode
echo "Switching the Origin One to USER control mode ..."
if ! REPLY=$(RMW_IMPLEMENTATION=$ROBOT_RMW timeout 30 ros2 service call "$SRV" \
    origin_msgs/srv/SetControlMode "{mode: {mode: 30}}"); then
  echo "FAILED: $SRV not reachable. Is the stack running and connected to the robot?" >&2
  exit 1
fi
echo "$REPLY" | tail -1
# The robot refuses USER while a mode with more authority is active: MANUAL (joystick /
# remote, 10) > TELEOPS (11) > AUTOPILOT (20) and USER (30).
if ! echo "$REPLY" | grep -q "success=True"; then
  MODE=$(timeout 8 ros2 topic echo --once /robot/control_mode 2>/dev/null \
    | grep -o 'mode: [0-9]*' | tail -1 | grep -o '[0-9]*')
  echo "REFUSED: the robot did not accept USER control (current control mode: ${MODE:-unknown};" \
       "10 = MANUAL joystick/remote, 11 = TELEOPS, 20 = AUTOPILOT)." >&2
  echo "The joystick/remote has priority: release it (turn the joystick off or disconnect" \
       "its Bluetooth) and run origin-enable-driving again. Nothing will drive until then." >&2
  exit 1
fi
# Call directly (ros2 service call waits for discovery; a fresh `service list` may be empty).
if timeout 20 ros2 service call /frontier_explorer/start std_srvs/srv/Trigger "{}" \
    | grep -q "success=True"; then
  echo "Frontier exploration started: the robot spins once, then explores."
else
  echo "NO FRONTIER EXPLORER: the stack runs in NAVIGATE mode (a finished map was found), so" \
       "the robot only moves to goals you send with RViz '2D Goal Pose'." >&2
  echo "To explore from scratch instead: restart the container with" \
       "'ros2 launch origin_bringup bringup.launch.py sim:=false mode:=explore'." >&2
fi
