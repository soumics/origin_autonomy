<?xml version="1.0"?>
<!--
  origin_office_people: the origin_office floor plan plus moving and standing people, chairs
  and other objects from YOLO's COCO classes, for perception tests. Identical objects
  (3 walking people, 5 office chairs, 2 dining chairs) must be counted separately.
  Ground truth: person 6 (3 walking), chair 7, couch 1, refrigerator 1, dining table 1.
  The plain boxes of origin_office are left out (YOLO mistakes them for tables/fridges).
  Models are downloaded from Gazebo Fuel on first use.

  Base world: small enclosed indoor world for testing mapping, localization and
  frontier exploration with the Avular Origin One (Gazebo Harmonic).

  20 x 14 m floor, 2.5 m walls, five rooms joined by 1.5 m doorways. Obstacles of
  different heights (pillars, cabinet, shelf, crate, bench, a 0.25 m box and a table
  that is open underneath) exercise 3D mapping. Uses no Fuel models, so it
  loads offline. Suggested spawn: (0, 0), yaw 0, in the central hall.
-->
<sdf version="1.9">
  <world name="origin_office_people">
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.453423125136865</latitude_deg>
      <longitude_deg>5.448826930660351</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_00">
      <static>true</static>
      <pose>0.0 -7 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_01">
      <static>true</static>
      <pose>0.0 7 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_02">
      <static>true</static>
      <pose>-10 0.0 1.25 0 0 0</pose>
      <link name="link">
