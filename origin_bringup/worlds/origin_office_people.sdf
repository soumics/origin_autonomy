    <!-- ===== perception test objects ===== -->
    <actor name="walker_hall_loop">
      <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/1/files/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/1/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.00</time><pose>-2.0 -1.8 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>6.86</time><pose>2.8 -1.8 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>7.86</time><pose>2.8 -1.8 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>13.00</time><pose>2.8 1.8 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>14.00</time><pose>2.8 1.8 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>20.86</time><pose>-2.0 1.8 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>21.86</time><pose>-2.0 1.8 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>27.00</time><pose>-2.0 -1.8 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>28.00</time><pose>-2.0 -1.8 1.0 0 0 0.0000</pose></waypoint>
        </trajectory>
      </script>
    </actor>
    <actor name="walker_hall_north">
      <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/1/files/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/1/files/meshes/walk.dae</filename>
