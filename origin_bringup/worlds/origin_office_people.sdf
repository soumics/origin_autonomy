      <script>
        <loop>true</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.00</time><pose>-2.2 4.5 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>7.43</time><pose>3.0 4.5 1.0 0 0 0.0000</pose></waypoint>
          <waypoint><time>8.43</time><pose>3.0 4.5 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>15.86</time><pose>-2.2 4.5 1.0 0 0 3.1416</pose></waypoint>
