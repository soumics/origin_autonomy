<?xml version="1.0"?>
<!--
  origin_office: small enclosed indoor world for testing mapping, localization and
  frontier exploration with the Avular Origin One (Gazebo Harmonic).

  20 x 14 m floor, 2.5 m walls, five rooms joined by 1.5 m doorways. Obstacles of
  different heights (pillars, cabinet, shelf, crate, bench, a 0.25 m box and a table
  that is open underneath) exercise 3D mapping. Uses no Fuel models, so it
  loads offline. Suggested spawn: (0, 0), yaw 0, in the central hall.
-->
<sdf version="1.9">
  <world name="origin_office">
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>51.453423125136865</latitude_deg>
      <longitude_deg>5.448826930660351</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_00">
      <static>true</static>
      <pose>0.0 -7 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_01">
      <static>true</static>
      <pose>0.0 7 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>20.2 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>20.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_02">
      <static>true</static>
      <pose>-10 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 14.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 14.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_03">
      <static>true</static>
      <pose>10 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 14.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 14.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_04">
      <static>true</static>
      <pose>-3 -5.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 2.7 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.7 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_05">
      <static>true</static>
      <pose>-3 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 6.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_06">
      <static>true</static>
      <pose>-3 5.75 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 2.7 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.7 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_07">
      <static>true</static>
      <pose>4 -4.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 6.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 6.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_08">
      <static>true</static>
      <pose>4 2.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 4.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 4.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_09">
      <static>true</static>
      <pose>4 6.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 1.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_10">
      <static>true</static>
      <pose>-8.75 1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.7 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.7 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_11">
      <static>true</static>
      <pose>-4.5 1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.2 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_12">
      <static>true</static>
      <pose>5.25 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.7 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.7 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_13">
      <static>true</static>
      <pose>9.0 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.2 0.2 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.2 0.2 2.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_n">
      <static>true</static>
      <pose>0 3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_s">
      <static>true</static>
      <pose>0 -3 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_w">
      <static>true</static>
      <pose>-8 -4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cabinet_se">
      <static>true</static>
      <pose>7 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.3 0.35 0.6 1</ambient><diffuse>0.3 0.35 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_ne">
      <static>true</static>
      <pose>8 4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 0.5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.5 0.8</size></box></geometry>
          <material><ambient>0.35 0.55 0.35 1</ambient><diffuse>0.35 0.55 0.35 1</diffuse></material></visual>
      </link>
    </model>
    <model name="low_box_hall">
      <static>true</static>
      <pose>1.5 -5 0.125 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.25</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.25</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="bench_hall">
      <static>true</static>
      <pose>-1.5 5.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 0.4 0.5</size></box></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="table_nw">
      <static>true</static>
      <pose>-7 4.5 0 0 0 0</pose>
      <link name="link">
        <collision name="top_c"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.4 0.8 0.04</size></box></geometry></collision>
        <visual name="top_v"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.4 0.8 0.04</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
        <collision name="leg0_c"><pose>0.65 0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg0_v"><pose>0.65 0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></visual>
        <collision name="leg1_c"><pose>-0.65 0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg1_v"><pose>-0.65 0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></visual>
        <collision name="leg2_c"><pose>0.65 -0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg2_v"><pose>0.65 -0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></visual>
        <collision name="leg3_c"><pose>-0.65 -0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></collision>
        <visual name="leg3_v"><pose>-0.65 -0.35 0.355 0 0 0</pose><geometry><box><size>0.05 0.05 0.71</size></box></geometry></visual>
